{
  "name": "dizychat-server",
  "version": "1.0.0",
  "description": "DizyChat server with Socket.IO, MongoDB, and file uploads",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node tests/run-deterministic-tests.js",
    "android:prepare": "node scripts/prepare-android-assets.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@capacitor/cli": "7.6.10",
    "@capacitor/core": "7.6.10",
    "@capacitor/push-notifications": "7.0.7",
    "cheerio": "1.1.2",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "firebase-admin": "14.4.0",
    "mongoose": "7.8.12",
    "multer": "2.5.0",
    "node-fetch": "3.3.2",
    "sanitize-html": "2.18.1",
    "socket.io": "4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.10",
    "brace-expansion": "1.1.21"
  },
  "keywords": [
    "chat",
    "socket.io",
    "mongodb",
    "express",
    "file-upload"
  ],
  "author": "Dizygotic",
  "license": "MIT",
  "overrides": {
    "gaxios": {
      "uuid": "11.1.1"
    },
    "rimraf": {
      "glob": "14.0.3"
    }
  }
}
