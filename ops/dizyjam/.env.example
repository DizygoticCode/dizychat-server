# Docker image for the self-hosted JackTrip hub.
DIZYJAM_IMAGE=jacktrip/jacktrip:latest

# Hub audio settings. All clients must use a compatible sample rate.
DIZYJAM_SAMPLE_RATE=48000
DIZYJAM_BUFFER_SIZE=128
DIZYJAM_UDP_BASE_PORT=61002

# These values belong in the DizyChat server environment as well.
# Set DIZYJAM_HOST to the public FQDN or static IP that remote musicians use.
ENABLE_DIZYJAM=true
DIZYJAM_HOST=
DIZYJAM_TCP_PORT=4464
DIZYJAM_UDP_END_PORT=61100

# Ephemeral credentials are issued by DizyChat and removed on room leave/sign-out.
# The same defaults are used by server-core.js.
DIZYJAM_CREDENTIAL_TTL_SECONDS=7200
# Optional override; normally leave unset so ~/DizyChat/ops/dizyjam/runtime is used.
# DIZYJAM_AUTH_DIR=/absolute/path/to/DizyChat/ops/dizyjam/runtime
